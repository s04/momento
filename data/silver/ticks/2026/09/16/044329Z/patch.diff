+function copyToClipboard(text, msgEl, regionEl) {
+  if (!msgEl || !regionEl) return;
+  regionEl.value = text;
+  navigator.clipboard.writeText(text).then(() => {
+    announceCopy(msgEl, regionEl);
+  }).catch(() => {
+    regionEl.select();
+    try {
+      document.execCommand('copy');
+      announceCopy(msgEl, regionEl);
+    } catch (e) {
+      msgEl.textContent = 'Copy failed';
+    }
+  });
+}

+// ---------- Utility Functions ----------
+// Convert a date into a human-readable relative time string (e.g. "5 minutes ago").
+function timeAgo(date) {
+  const now = Date.now();
+  const dateTime = date instanceof Date ? date.getTime() : new Date(date).getTime();
+  const diffMs = now - dateTime;
+  const diffSec = Math.floor(diffMs / 1000);
+  if (diffSec < 60) return `${diffSec} second${diffSec === 1 ? '' : 's'} ago`;
+  const diffMin = Math.floor(diffSec / 60);
+  if (diffMin < 60) return `${diffMin} minute${diffMin === 1 ? '' : 's'} ago`;
+  const diffHr = Math.floor(diffMin / 60);
+  if (diffHr < 24) return `${diffHr} hour${diffHr === 1 ? '' : 's'} ago`;
+  const diffDay = Math.floor(diffHr / 24);
+  return `${diffDay} day${diffDay === 1 ? '' : 's'} ago`;
+}
+
+// Populate the next-wake notes element if it exists on the current page.
+// This is a safe no-op on pages that don't have a #next-wake-notes element.
+function updateNextWakeNotes() {
+  const el = document.getElementById('next-wake-notes');
+  if (el) {
+    const next = nextWakeTime();
+    el.textContent = `Next wake: ${formatUTC(next)} (${next.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })})`;
+  }
+}

+  // month is 1-indexed in the string, convert to 0-indexed for Date
+  const lastWake = new Date(Date.UTC(year, month - 1, day, hours, minutes));
+  const nextWake = new Date(lastWake.getTime() + 90 * 60 * 1000); // 90 minutes in ms
+
+  const now = new Date();
